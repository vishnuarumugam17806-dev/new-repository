# ============================================================
# SMART DB — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ============================================================

# Flask Secret Key (change this to a long random string in production)
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Leave blank to use the enhanced rule-based fallback engine
OPENAI_API_KEY=

# OpenAI Model (default: gpt-4o-mini for cost efficiency, use gpt-4o for best results)
OPENAI_MODEL=gpt-4o-mini

# --- Database Configuration ---
# Option 1: SQLite (default, no config needed)
# DATABASE_URL=

# Option 2: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smartdb

# Option 3: MS SQL Server
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=smartdb
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# --- Redis (optional, for caching) ---
# Leave blank to disable caching
REDIS_URL=

# --- App Settings ---
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
